#show: doc => conf(
    "Planeswalker's Guide to Secrets of Strixhaven",
    set_name: "Secrets of Strixhaven",
    story_date: datetime(day: 16, month: 3, year: 2026),
    author: "Wizards of the Coast",
    doc
